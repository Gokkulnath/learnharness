+/*
+ * Mobile / installed-app baseline (owner, mobile round 2026-10-26).
+ *
+ * Chrome Android pulls-to-refresh the document when a downward drag reaches
+ * the top; in a full-screen lesson that reload discards the composer and the
+ * scroll position. The app's own scrollers own their overscroll, so the
+ * document never rubber-bands. text-size-adjust stops Chrome's font boosting
+ * from rewriting the declared 16px type scale on wide paragraphs, and the
+ * tap highlight is suppressed because every surface carries its own active
+ * state (the app's "no browser chrome" rule).
+ */
+html {
+	background: var(--color-background);
+	overscroll-behavior-y: none;
+	-webkit-text-size-adjust: 100%;
+	text-size-adjust: 100%;
+}
+
+body {
+	-webkit-tap-highlight-color: transparent;
+	overscroll-behavior-y: none;
+}
+
+/*
+ * Chrome Android zooms the page when a focused form control's font is under
+ * 16px. Keep the declared type scale on pointer devices, but never let a
+ * settings field or the session search trigger a viewport zoom. max() keeps
+ * intentionally larger controls at their size.
+ */
+@media (pointer: coarse) {
+	input,
+	textarea,
+	select {
+		font-size: max(16px, 1em);
+	}
+}
+
+/*
+ * Phone density (owner, mobile round 2, 2026-10-26): below the drawer
+ * breakpoint the browser UI steps down to 80% — type, spacing, and the
+ * controls built from them. It is a variable scale, not a transform, so
+ * fixed drawers, safe-area insets, and scroll geometry keep their meaning.
+ *
+ * Electron is excluded: its window has its own zoom and it never takes the
+ * compact drawer path. The media query applies on the first paint (no
+ * post-hydration reflow), and the variables on <html> also reach portaled
+ * menus/dialogs.
+ */
+@media (max-width: 927px) {
+	html:not(.lh-electron) {
+		--lh-ui-scale: 0.8;
+		--spacing: calc(0.25rem * var(--lh-ui-scale));
+		--lh-prose-size: calc(16px * var(--lh-ui-scale));
+	}
+
+	/* Chrome Android zooms on focus below 16px. The .lh-input class would
+	   otherwise beat the plain element rule above and undo this floor. */
+	html:not(.lh-electron) :is(input, textarea, select, .lh-input) {
+		font-size: max(16px, 1em);
+	}
+
+	/*
+	 * Dock fit (owner, same round): the question sheet's old cap measured
+	 * the whole column but only applied it to the question/options area;
+	 * confidence + answer + stats could then push the shell's top under the
+	 * conversation's overflow clip. The overlay now takes at most the
+	 * conversation column, and exactly one row — the question/options
+	 * scroller — is flexible. Fixed rows stay reachable at every height.
+	 */
+	html:not(.lh-electron) .lh-dock-fit {
+		display: flex;
+		flex-direction: column;
+		max-height: 100%;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-gradient {
+		flex: 0 0 auto;
+		/* Must match GRADIENT_H in components/chat.tsx (96). */
+		height: 96px;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-block {
+		display: flex;
+		flex: 1 1 auto;
+		flex-direction: column;
+		min-height: 0;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-stack {
+		display: flex;
+		flex: 1 1 auto;
+		flex-direction: column;
+		min-height: 0;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-stack > :not(.lh-dock-shell) {
+		flex: 0 0 auto;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-shell {
+		display: flex;
+		flex: 0 1 auto;
+		flex-direction: column;
+		min-height: 0;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-content {
+		display: flex;
+		flex: 1 1 auto;
+		flex-direction: column;
+		min-height: 0;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-panel {
+		display: flex;
+		flex: 1 1 auto;
+		flex-direction: column;
+		min-height: 0;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-scroll {
+		flex: 1 1 auto;
+		min-height: 0;
+	}
+
+	html:not(.lh-electron) .lh-dock-fit .lh-dock-fixed {
+		flex: 0 0 auto;
+	}
